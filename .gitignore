!/public/photos/18396_award.jpg
!/public/photos/18397_award-pic1.jpg
!/public/photos/18427_draward.jpg
!/public/photos/blog/
!/public/photos/blog/**
# Blog post cover images referenced from Google Sheet (id-prefixed filenames)
!/public/photos/17821_seasonal-treatment.jpg
!/public/photos/17824_healthy-baby-with-Homoeopathy.jpg
!/public/photos/17830_permanent-cure-homoeopathy.jpg
